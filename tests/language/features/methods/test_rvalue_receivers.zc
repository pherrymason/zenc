// language/features/methods: a temporary used where a pointer is needed (a
// `self` receiver, or the left side of an overloaded `==`) goes through a
// temporary copy, also when it is a field of a call result or a bare variant.
import "std/vec.zc"

@derive(Copy)
struct Handle<K> { value: u32; }

impl Handle<K> {
    fn of(raw: u32) -> Handle<K> { return Handle<K> { value: raw }; }
    fn eq(self, other: Handle<K>) -> bool { return self.value == other.value; }
}

struct PairKind {}
alias PairId = Handle<PairKind>;

struct Pair { id: PairId; }

enum Kit { None = 0, Swab, Cast }

impl Kit {
    fn is_swab(self) -> bool { return *self == Kit::Swab; }
}

test "overloaded == on a field of a call result" {
    let pairs = Vec<Pair>::new();
    pairs.push(Pair { id: PairId::of(1) });
    assert(pairs.get(0).id == PairId::of(1), "field of a call result");
}

test "method on a variant written without ()" {
    assert(Kit::Swab.is_swab(), "bare variant receiver");
    assert(!Kit::Cast.is_swab(), "another bare variant receiver");
}
